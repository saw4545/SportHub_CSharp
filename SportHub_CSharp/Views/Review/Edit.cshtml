
@model SportHub_CSharp.Models.REVIEW

@{
    ViewBag.Title = "Edit Review";
}

<div class="container"
     style="margin-top:30px; max-width:750px;">

    <div style="
        background:#ffc107;
        color:#212529;
        padding:20px;
        border-radius:8px;
        margin-bottom:25px;">

        <h2 style="margin:0;">
            ✏️ Edit Review
        </h2>

    </div>


    @using (Html.BeginForm("Edit", "Review", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(model => model.ReviewID)


        <!-- Facility -->

        <div class="form-group">

            <label>
                Facility
            </label>

            <input type="text"
                   class="form-control"
                   value="@(Model.BOOKING != null &&
                            Model.BOOKING.FACILITY != null
                            ? Model.BOOKING.FACILITY.Name
                            : "Facility")"
                   readonly />

        </div>


        <!-- Rating -->

        <div class="form-group"
             style="margin-top:20px;">

            <label>
                Rating
            </label>

            <select name="Rating"
                    class="form-control"
                    required>

                <option value="5"
                        @(Model.Rating == 5 ? "selected" : "")>
                    ⭐⭐⭐⭐⭐ - Excellent
                </option>

                <option value="4"
                        @(Model.Rating == 4 ? "selected" : "")>
                    ⭐⭐⭐⭐ - Very Good
                </option>

                <option value="3"
                        @(Model.Rating == 3 ? "selected" : "")>
                    ⭐⭐⭐ - Good
                </option>

                <option value="2"
                        @(Model.Rating == 2 ? "selected" : "")>
                    ⭐⭐ - Poor
                </option>

                <option value="1"
                        @(Model.Rating == 1 ? "selected" : "")>
                    ⭐ - Very Poor
                </option>

            </select>

        </div>


        <!-- Comment -->

        <div class="form-group"
             style="margin-top:20px;">

            <label>
                Your Review
            </label>

            <textarea name="ReviewComment"
                      class="form-control"
                      rows="5"
                      required>@Model.ReviewComment</textarea>

        </div>


        <!-- Buttons -->

        <div style="margin-top:25px;">

            <button type="submit"
                    class="btn btn-primary">

                Save Changes

            </button>

            <a href="@Url.Action("Index", "Review")"
               class="btn btn-secondary"
               style="margin-left:5px;">

                Cancel

            </a>

        </div>

    }

</div>