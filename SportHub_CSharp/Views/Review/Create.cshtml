@model SportHub_CSharp.Models.REVIEW

@{
    ViewBag.Title = "Write a Review";
}

<div class="container" style="margin-top:30px; max-width:800px;">

    <!-- Header -->
    <div style="
        background:#0d6efd;
        color:white;
        padding:20px;
        border-radius:8px;
        margin-bottom:25px;">

        <h2 style="margin:0;">
            ⭐ Write a Review
        </h2>

        <p style="margin:8px 0 0 0;">
            Share your experience with SportHub.
        </p>

    </div>

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Review Form -->
    <div class="panel panel-default">

        <div class="panel-heading"
             style="font-size:18px; font-weight:bold;">
            Submit Your Review
        </div>

        <div class="panel-body">

            @using (Html.BeginForm("Create", "Review", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <!-- Booking -->
                <div class="form-group" style="margin-bottom:20px;">

                    <label for="BookingID">
                        Booking
                    </label>

                    @Html.DropDownList(
                        "BookingID",
                        ViewBag.BookingList as SelectList,
                        "-- Select Your Booking --",
                        new
                        {
                            @class = "form-control"
                        }
                    )

                    @Html.ValidationMessage(
                        "BookingID",
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

                <!-- Rating -->
                <div class="form-group" style="margin-bottom:20px;">

                    <label for="Rating">
                        Rating
                    </label>

                    <select name="Rating"
                            id="Rating"
                            class="form-control">

                        <option value="">-- Select Rating --</option>
                        <option value="5">⭐⭐⭐⭐⭐ Excellent</option>
                        <option value="4">⭐⭐⭐⭐ Very Good</option>
                        <option value="3">⭐⭐⭐ Good</option>
                        <option value="2">⭐⭐ Fair</option>
                        <option value="1">⭐ Poor</option>

                    </select>

                    @Html.ValidationMessage(
                        "Rating",
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

                <!-- Comment -->
                <div class="form-group" style="margin-bottom:20px;">

                    <label for="ReviewComment">
                        Your Review
                    </label>

                    @Html.TextAreaFor(
                        model => model.ReviewComment,
                        new
                        {
                            @class = "form-control",
                            rows = "5",
                            placeholder = "Write your experience here..."
                        }
                    )

                    @Html.ValidationMessage(
                        "ReviewComment",
                        "",
                        new { @class = "text-danger" }
                    )

                </div>

                <!-- Buttons -->
                <div style="margin-top:25px;">

                    <button type="submit"
                            class="btn btn-primary">

                        ⭐ Submit Review

                    </button>

                    <a href="@Url.Action("Index", "Review")"
                       class="btn btn-secondary"
                       style="margin-left:10px;">

                        Cancel

                    </a>

                </div>
            }

        </div>

    </div>

</div>