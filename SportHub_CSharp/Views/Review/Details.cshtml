@model SportHub_CSharp.Models.REVIEW

@{
    ViewBag.Title = "Review Details";
}

<div class="container" style="margin-top:30px;">

    <div style="
        background:#0d6efd;
        color:white;
        padding:20px;
        border-radius:6px;
        margin-bottom:25px;">

        <h2 style="margin:0;">
            Review Details
        </h2>

    </div>


    <div class="panel panel-default">

        <div class="panel-heading">
            <strong>Review Information</strong>
        </div>


        <div class="panel-body">

            <p>
                <strong>Review ID:</strong>
                @Model.ReviewID
            </p>


            <p>
                <strong>Facility:</strong>

                @if (Model.BOOKING != null &&
                    Model.BOOKING.FACILITY != null)
                {
                    @Model.BOOKING.FACILITY.Name
                }
                else
                {
                    <span>N/A</span>
                }

            </p>


            <p>
                <strong>Booking Date:</strong>

                @if (Model.BOOKING != null)
                {
                    @Model.BOOKING.BookingDate.ToString("dd/MM/yyyy")
                }
                else
                {
                    <span>N/A</span>
                }

            </p>


            <p>
                <strong>Rating:</strong>

                @for (int i = 1; i <= 5; i++)
                {
                    if (i <= Model.Rating)
                    {
                        <span style="font-size:25px;">
                            ★
                        </span>
                    }
                    else
                    {
                        <span style="
                            font-size:25px;
                            color:#ccc;">
                            ★
                        </span>
                    }
                }

                <strong>
                    (@Model.Rating / 5)
                </strong>

            </p>


            <p>
                <strong>Comment:</strong>
            </p>

            <div class="well">
                @Model.ReviewComment
            </div>


            <p>
                <strong>Review Date:</strong>
                @Model.ReviewDate.ToString("dd/MM/yyyy HH:mm")
            </p>


            <hr />


            <a href="@Url.Action(
                "Index",
                "Review")"
               class="btn btn-primary">

                Back to My Reviews

            </a>


            <a href="@Url.Action(
                "MyBookings",
                "Booking")"
               class="btn btn-info"
               style="margin-left:5px;">

                My Bookings

            </a>

        </div>

    </div>

</div>