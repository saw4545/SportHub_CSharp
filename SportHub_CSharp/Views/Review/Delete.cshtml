@model SportHub_CSharp.Models.REVIEW

@{
    ViewBag.Title = "Delete Review";
}

<div class="container" style="margin-top:30px; max-width:700px;">

    <div class="alert alert-danger">

        <h3>Delete Review</h3>

        <p>
            Are you sure you want to delete this review?
        </p>

    </div>

    <div class="panel panel-default">

        <div class="panel-body">

            <dl class="dl-horizontal">

                <dt>
                    Rating
                </dt>

                <dd>
                    @for (int i = 1; i <= 5; i++)
                    {
                        if (i <= Model.Rating)
                        {
                            <span>⭐</span>
                        }
                        else
                        {
                            <span>☆</span>
                        }
                    }
                </dd>

                <dt>
                    Comment
                </dt>

                <dd>
                    @Model.ReviewComment
                </dd>

                <dt>
                    Review Date
                </dt>

                <dd>
                    @Model.ReviewDate.ToString("dd/MM/yyyy HH:mm")
                </dd>

            </dl>

            @using (Html.BeginForm(
                "Delete",
                "Review",
                FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(
                    model => model.ReviewID
                )

                <button type="submit"
                        class="btn btn-danger">

                    Delete Review

                </button>

                <a href="@Url.Action(
                    "Index",
                    "Review")"
                   class="btn btn-secondary"
                   style="margin-left:5px;">

                    Cancel

                </a>
            }

        </div>

    </div>

</div>