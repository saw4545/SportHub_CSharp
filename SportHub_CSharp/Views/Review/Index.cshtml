@model IEnumerable<SportHub_CSharp.Models.REVIEW>

@{
    ViewBag.Title = "Reviews";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:30px; margin-bottom:50px;">

    <!-- ========================================= -->
    <!-- PAGE HEADER -->
    <!-- ========================================= -->

    <div style="
        background:#0d6efd;
        color:white;
        padding:20px;
        border-radius:8px;
        margin-bottom:25px;">

        <h2 style="margin:0;">
            ⭐ Customer Reviews
        </h2>

        <p style="margin-top:8px; margin-bottom:0;">
            See what our members say about SportHub facilities.
        </p>

    </div>


    <!-- ========================================= -->
    <!-- SUCCESS MESSAGE -->
    <!-- ========================================= -->

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ========================================= -->
    <!-- ERROR MESSAGE -->
    <!-- ========================================= -->

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- ========================================= -->
    <!-- ACTION BUTTONS -->
    <!-- ========================================= -->

    <div style="margin-bottom:25px;">

        @if (Session["MemberID"] != null)
        {
            <a href="@Url.Action("Create", "Review")"
               class="btn btn-primary">

                ⭐ Write a Review

            </a>
        }
        else
        {
            <a href="@Url.Action("Login", "Member")"
               class="btn btn-primary">

                🔐 Login to Write a Review

            </a>
        }

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-secondary"
           style="margin-left:5px;">

            🏠 Back to Home

        </a>

    </div>


    <!-- ========================================= -->
    <!-- SEARCH AND FILTER -->
    <!-- ========================================= -->

    <div class="panel panel-default"
         style="
         margin-bottom:25px;
         border-radius:8px;
         box-shadow:0 2px 5px rgba(0,0,0,0.08);">

        <div class="panel-heading"
             style="
             font-size:18px;
             font-weight:bold;
             padding:15px;">

            🔍 Search & Filter Reviews

        </div>


        <div class="panel-body"
             style="padding:20px;">

            <form method="get"
                  action="@Url.Action("Index", "Review")">

                <div class="row">

                    <!-- SEARCH -->
                    <div class="col-md-6">

                        <label>
                            Search Reviews
                        </label>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Search review text or booking ID..." />

                    </div>


                    <!-- RATING -->
                    <div class="col-md-3">

                        <label>
                            Rating
                        </label>

                        <select name="rating"
                                class="form-control">

                            <option value="">
                                All Ratings
                            </option>

                            <option value="5"
                                    @(ViewBag.Rating != null && ViewBag.Rating.ToString() == "5" ? "selected" : "")>

                                ⭐⭐⭐⭐⭐ 5 Stars

                            </option>

                            <option value="4"
                                    @(ViewBag.Rating != null && ViewBag.Rating.ToString() == "4" ? "selected" : "")>

                                ⭐⭐⭐⭐ 4 Stars

                            </option>

                            <option value="3"
                                    @(ViewBag.Rating != null && ViewBag.Rating.ToString() == "3" ? "selected" : "")>

                                ⭐⭐⭐ 3 Stars

                            </option>

                            <option value="2"
                                    @(ViewBag.Rating != null && ViewBag.Rating.ToString() == "2" ? "selected" : "")>

                                ⭐⭐ 2 Stars

                            </option>

                            <option value="1"
                                    @(ViewBag.Rating != null && ViewBag.Rating.ToString() == "1" ? "selected" : "")>

                                ⭐ 1 Star

                            </option>

                        </select>

                    </div>


                    <!-- SEARCH BUTTON -->
                    <div class="col-md-3">

                        <label>
                            &nbsp;
                        </label>

                        <button type="submit"
                                class="btn btn-primary"
                                style="width:100%;">

                            🔍 Search

                        </button>

                    </div>

                </div>


                <!-- ================================= -->
                <!-- CLEAR FILTER -->
                <!-- ================================= -->

                @if (!String.IsNullOrWhiteSpace(ViewBag.Search as String)
                    || ViewBag.Rating != null)
                {
                    <div style="margin-top:15px;">

                        <span class="text-muted">

                            🔎 Filter applied

                        </span>

                        <a href="@Url.Action("Index", "Review")"
                           class="btn btn-secondary btn-sm"
                           style="margin-left:10px;">

                            Clear Filters

                        </a>

                    </div>
                }

            </form>

        </div>

    </div>


    <!-- ========================================= -->
    <!-- REVIEWS -->
    <!-- ========================================= -->

    @if (Model != null && Model.Any())
    {
        foreach (var review in Model)
        {
            <div class="panel panel-default"
                 style="
                 margin-bottom:20px;
                 border-radius:8px;
                 box-shadow:0 2px 5px rgba(0,0,0,0.1);">

                <!-- REVIEW HEADER -->

                <div class="panel-heading">

                    <strong>
                        Review #@review.ReviewID
                    </strong>

                    <span style="float:right;">
                        @review.ReviewDate.ToString("dd/MM/yyyy")
                    </span>

                </div>


                <div class="panel-body">

                    <!-- ================================= -->
                    <!-- FACILITY -->
                    <!-- ================================= -->

                    <h4>

                        🏟️

                        @if (review.BOOKING != null &&
                             review.BOOKING.FACILITY != null)
                        {
                            @review.BOOKING.FACILITY.Name
                        }
                        else
                        {
                            <span>
                                Facility unavailable
                            </span>
                        }

                    </h4>


                    <!-- ================================= -->
                    <!-- RATING -->
                    <!-- ================================= -->

                    <div style="
                        font-size:22px;
                        margin:10px 0;">

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span>⭐</span>
                            }
                            else
                            {
                                <span>☆</span>
                            }
                        }

                        <strong>
                            (@review.Rating / 5)
                        </strong>

                    </div>


                    <!-- ================================= -->
                    <!-- COMMENT -->
                    <!-- ================================= -->

                    <p style="
                        font-size:16px;
                        margin-bottom:15px;">

                        @review.ReviewComment

                    </p>


                    <!-- ================================= -->
                    <!-- MEMBER'S OWN REVIEW ACTIONS -->
                    <!-- ================================= -->

                    @if (Session["MemberID"] != null &&
                         review.BOOKING != null &&
                         Convert.ToInt32(Session["MemberID"])
                         == review.BOOKING.MemberID)
                    {
                        <hr />

                        <a href="@Url.Action(
                            "Edit",
                            "Review",
                            new { id = review.ReviewID })"
                           class="btn btn-warning btn-sm">

                            ✏️ Edit

                        </a>

                        <a href="@Url.Action(
                            "Delete",
                            "Review",
                            new { id = review.ReviewID })"
                           class="btn btn-danger btn-sm">

                            🗑️ Delete

                        </a>
                    }

                </div>

            </div>
        }
    }
    else
    {
        <!-- ========================================= -->
        <!-- NO RESULTS -->
        <!-- ========================================= -->

        <div class="alert alert-info text-center">

            <h4>
                No reviews found.
            </h4>

            <p>
                Try changing your search or rating filter.
            </p>

            @if (Session["MemberID"] != null)
            {
                <a href="@Url.Action("Create", "Review")"
                   class="btn btn-primary">

                    ⭐ Write a Review

                </a>
            }

        </div>
    }

</div>