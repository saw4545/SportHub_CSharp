@{
    ViewBag.Title = "Return Equipment";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-6">

            <div class="card shadow">

                <div class="card-header bg-success text-white text-center">

                    <h3>
                        🔄 Return Equipment
                    </h3>

                </div>

                <div class="card-body text-center">

                    <div style="font-size:70px;">
                        🏀
                    </div>

                    <h4 class="mt-3">
                        Return this equipment?
                    </h4>

                    <p class="text-muted">
                        The equipment will be marked as returned and
                        its available quantity will be increased.
                    </p>

                    @using (Html.BeginForm("ReturnEquipment",
                                           "Rental",
                                           FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="id"
                               value="@ViewBag.RentalID" />

                        <button type="submit"
                                class="btn btn-success">

                            Confirm Return

                        </button>

                        <a href="@Url.Action("Index", "Rental")"
                           class="btn btn-secondary">

                            Cancel

                        </a>
                    }

                </div>

            </div>

        </div>

    </div>

</div>