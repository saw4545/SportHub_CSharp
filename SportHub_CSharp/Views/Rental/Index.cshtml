@model IEnumerable<SportHub_CSharp.Models.RENTAL>

@{
    ViewBag.Title = "My Equipment Rentals";
}

<div class="container" style="margin-top:30px;">

    <!-- Page Header -->
    <div style="
        background:#0d6efd;
        color:white;
        padding:15px 20px;
        border-radius:6px;
        margin-bottom:20px;">
        <h2 style="margin:0;">
            My Equipment Rentals
        </h2>
    </div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    <!-- Error Message -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    <!-- Rent Equipment Button -->
    <div style="margin-bottom:20px;">
        <a href="@Url.Action("Index", "Equipment")"
           class="btn btn-primary">
            🏏 Rent Equipment
        </a>

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-secondary"
           style="margin-left:5px;">
            Back to Home
        </a>
    </div>

    <!-- Rental Table -->
    <div class="panel panel-default">

        <div class="panel-heading"
             style="font-size:18px; font-weight:bold;">
            My Rental History
        </div>

        <div class="panel-body">

            @if (Model != null && Model.Any())
            {
                <div class="table-responsive">

                    <table class="table table-bordered table-striped">

                        <thead style="
                            background:#212529;
                            color:white;">

                            <tr>
                                <th>Rental ID</th>
                                <th>Equipment</th>
                                <th>Type</th>
                                <th>Rent Date</th>
                                <th>Return Date</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var rental in Model)
                            {
                                <tr>

                                    <!-- Rental ID -->
                                    <td>
                                        @rental.RentalID
                                    </td>

                                    <!-- Equipment Name -->
                                    <td>
                                        @if (rental.EQUIPMENT != null)
                                        {
                                            @rental.EQUIPMENT.Name
                                        }
                                        else
                                        {
                                            <span>Equipment unavailable</span>
                                        }
                                    </td>

                                    <!-- Equipment Type -->
                                    <td>
                                        @if (rental.EQUIPMENT != null)
                                        {
                                            @rental.EQUIPMENT.Type
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <!-- Rent Date -->
                                    <td>
                                        @rental.RentDate.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- Return Date -->
                                    <td>
                                        @if (rental.ReturnDate.HasValue)
                                        {
                                            @rental.ReturnDate.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>

                                    <!-- Status -->
                                    <td>

                                        @if (rental.Status == "Active")
                                        {
                                            <span class="label label-success">
                                                Active
                                            </span>
                                        }
                                        else if (rental.Status == "Returned")
                                        {
                                            <span class="label label-default">
                                                Returned
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="label label-warning">
                                                @rental.Status
                                            </span>
                                        }

                                    </td>

                                    <!-- Action -->
                                    <td>

                                        @if (rental.Status == "Active")
                                        {
                                            <a href="@Url.Action(
                                                "ReturnEquipment",
                                                "Rental",
                                                new { id = rental.RentalID })"
                                               class="btn btn-warning btn-sm"
                                               onclick="return confirm('Are you sure you want to return this equipment?');">
                                                Return
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">
                                                No action
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- No Rentals -->
                <div class="alert alert-info">

                    <h4>No Equipment Rentals</h4>

                    <p>
                        You have not rented any sports equipment yet.
                    </p>

                    <a href="@Url.Action("Index", "Equipment")"
                       class="btn btn-primary">
                        Browse Equipment
                    </a>

                </div>
            }

        </div>

    </div>

</div>