@{
    ViewBag.Title = "SportHub";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- =========================================================
     HERO SECTION
========================================================= -->

<section class="sporthub-hero">

    <div class="hero-overlay"></div>

    <div class="hero-content">

        <span class="hero-badge">
            🏆 YOUR SPORTS. YOUR WAY.
        </span>

        <h1>
            Welcome to <span>SportHub</span>
        </h1>

        @if (Session["MemberName"] != null)
        {
            <p class="hero-welcome">
                Welcome back,
                <strong>@Session["MemberName"]</strong>!
            </p>
        }
        else
        {
            <p class="hero-welcome">
                Everything you need for your next sporting experience.
            </p>
        }

        <p class="hero-description">
            Discover sports facilities, rent equipment,
            make bookings and enjoy your favourite sports
            all in one place.
        </p>

        <div class="hero-buttons">

            <a href="@Url.Action("Index", "Facility")"
               class="hero-btn hero-btn-primary">

                🏟️ Explore Facilities

            </a>

            <a href="@Url.Action("Index", "Equipment")"
               class="hero-btn hero-btn-outline">

                🏀 Browse Equipment

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     QUICK ACTIONS
========================================================= -->

<section class="quick-section">

    <div class="container">

        <div class="section-heading">

            <span>SPORTHUB SERVICES</span>

            <h2>
                Everything You Need To Play
            </h2>

            <p>
                Find facilities, equipment and services
                designed for your sporting lifestyle.
            </p>

        </div>


        <div class="quick-grid">

            <!-- Facilities -->

            <div class="quick-card">

                <div class="quick-image facility-image">

                    <div class="image-overlay">

                        <span class="big-icon">
                            🏟️
                        </span>

                    </div>

                </div>

                <div class="quick-content">

                    <h3>Sports Facilities</h3>

                    <p>
                        Find courts, grounds and other sports
                        facilities suitable for your favourite activities.
                    </p>

                    <a href="@Url.Action("Index", "Facility")">
                        Explore Facilities →
                    </a>

                </div>

            </div>


            <!-- Equipment -->

            <div class="quick-card">

                <div class="quick-image equipment-image">

                    <div class="image-overlay">

                        <span class="big-icon">
                            🏀
                        </span>

                    </div>

                </div>

                <div class="quick-content">

                    <h3>Sports Equipment</h3>

                    <p>
                        Rent quality sports equipment for training,
                        games and recreational activities.
                    </p>

                    <a href="@Url.Action("Index", "Equipment")">
                        Browse Equipment →
                    </a>

                </div>

            </div>


            <!-- Booking -->

            <div class="quick-card">

                <div class="quick-image booking-image">

                    <div class="image-overlay">

                        <span class="big-icon">
                            📅
                        </span>

                    </div>

                </div>

                <div class="quick-content">

                    <h3>Easy Booking</h3>

                    <p>
                        Reserve your preferred sports facility
                        quickly and conveniently.
                    </p>

                    <a href="@Url.Action("Index", "Booking")">
                        Make a Booking →
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FEATURED SPORTS SECTION
========================================================= -->

<section class="sports-section">

    <div class="container">

        <div class="section-heading light-heading">

            <span>POPULAR SPORTS</span>

            <h2>
                Find Your Favourite Sport
            </h2>

            <p>
                Whether you enjoy team sports or individual activities,
                SportHub helps you get started.
            </p>

        </div>


        <div class="sports-grid">

            <!-- Football -->

            <a href="@Url.Action("Index", "Facility")"
               class="sport-card football-card">

                <div class="sport-overlay">

                    <div>
                        <span>⚽</span>
                        <h3>Football</h3>
                        <p>Play. Compete. Enjoy.</p>
                    </div>

                </div>

            </a>


            <!-- Basketball -->

            <a href="@Url.Action("Index", "Facility")"
               class="sport-card basketball-card">

                <div class="sport-overlay">

                    <div>
                        <span>🏀</span>
                        <h3>Basketball</h3>
                        <p>Bring your game.</p>
                    </div>

                </div>

            </a>


            <!-- Tennis -->

            <a href="@Url.Action("Index", "Facility")"
               class="sport-card tennis-card">

                <div class="sport-overlay">

                    <div>
                        <span>🎾</span>
                        <h3>Tennis</h3>
                        <p>Serve your best.</p>
                    </div>

                </div>

            </a>


            <!-- Swimming -->

            <a href="@Url.Action("Index", "Facility")"
               class="sport-card swimming-card">

                <div class="sport-overlay">

                    <div>
                        <span>🏊</span>
                        <h3>Swimming</h3>
                        <p>Make a splash.</p>
                    </div>

                </div>

            </a>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW IT WORKS
========================================================= -->

<section class="how-section">

    <div class="container">

        <div class="section-heading">

            <span>HOW IT WORKS</span>

            <h2>
                Book Your Sport In 3 Easy Steps
            </h2>

            <p>
                SportHub makes your sporting experience simple.
            </p>

        </div>


        <div class="steps-grid">

            <div class="step-card">

                <div class="step-number">
                    01
                </div>

                <div class="step-icon">
                    🔎
                </div>

                <h3>
                    Find
                </h3>

                <p>
                    Browse available sports facilities
                    and equipment.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    02
                </div>

                <div class="step-icon">
                    📅
                </div>

                <h3>
                    Book
                </h3>

                <p>
                    Select your preferred date and
                    make your booking.
                </p>

            </div>


            <div class="step-card">

                <div class="step-number">
                    03
                </div>

                <div class="step-icon">
                    🏆
                </div>

                <h3>
                    Enjoy
                </h3>

                <p>
                    Arrive, play and enjoy your
                    favourite sport.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     INQUIRY / CONTACT CTA
========================================================= -->

<section class="inquiry-section">

    <div class="inquiry-overlay"></div>

    <div class="container inquiry-content">

        <div>

            <span>
                NEED HELP?
            </span>

            <h2>
                Have a Question About SportHub?
            </h2>

            <p>
                Send us an inquiry and our team will
                get back to you.
            </p>

        </div>

        <a href="@Url.Action("Create", "Inquiry")"
           class="inquiry-btn">

            📩 Send an Inquiry

        </a>

    </div>

</section>


<!-- =========================================================
     MEMBER CTA
========================================================= -->

@if (Session["MemberID"] == null)
{
    <section class="member-section">

        <div class="container">

            <div class="member-box">

                <div>

                    <span>
                        JOIN SPORT HUB
                    </span>

                    <h2>
                        Ready To Start Your Sporting Journey?
                    </h2>

                    <p>
                        Create your free SportHub account and
                        start booking facilities today.
                    </p>

                </div>

                <div class="member-buttons">

                    <a href="@Url.Action("Register", "Member")"
                       class="member-btn">

                        Create Account

                    </a>

                    <a href="@Url.Action("Login", "Member")"
                       class="member-login-btn">

                        Sign In

                    </a>

                </div>

            </div>

        </div>

    </section>
}


<!-- =========================================================
     CSS
========================================================= -->

<style>

    * {
        box-sizing: border-box;
    }


    body {
        background: #f7f9fc;
    }


    /* =====================================================
       HERO
    ===================================================== */

    .sporthub-hero {

        position: relative;

        min-height: 620px;

        display: flex;

        align-items: center;

        justify-content: center;

        text-align: center;

        color: white;

        background-image:
            url("https://images.unsplash.com/photo-1461896836934-ffe607ba8211?auto=format&fit=crop&w=2000&q=85");

        background-size: cover;

        background-position: center;

        overflow: hidden;

    }


    .hero-overlay {

        position: absolute;

        inset: 0;

        background:
            linear-gradient(
                135deg,
                rgba(0, 45, 110, 0.92),
                rgba(0, 102, 255, 0.70),
                rgba(0, 0, 0, 0.55)
            );

    }


    .hero-content {

        position: relative;

        z-index: 2;

        max-width: 900px;

        padding: 60px 20px;

    }


    .hero-badge {

        display: inline-block;

        padding: 9px 18px;

        border-radius: 50px;

        background: rgba(255,255,255,0.15);

        border: 1px solid rgba(255,255,255,0.35);

        font-size: 13px;

        font-weight: bold;

        letter-spacing: 1.5px;

        margin-bottom: 25px;

    }


    .hero-content h1 {

        font-size: 64px;

        line-height: 1.1;

        font-weight: 800;

        margin-bottom: 20px;

    }


    .hero-content h1 span {

        color: #65b5ff;

    }


    .hero-welcome {

        font-size: 25px;

        margin-bottom: 15px;

    }


    .hero-description {

        max-width: 700px;

        margin: auto;

        font-size: 18px;

        line-height: 1.7;

        color: rgba(255,255,255,0.90);

    }


    .hero-buttons {

        margin-top: 35px;

    }


    .hero-btn {

        display: inline-block;

        padding: 15px 28px;

        margin: 6px;

        border-radius: 8px;

        text-decoration: none !important;

        font-weight: bold;

        transition: all 0.25s ease;

    }


    .hero-btn-primary {

        background: #ffffff;

        color: #0066ff;

    }


    .hero-btn-primary:hover {

        transform: translateY(-3px);

        color: #0044aa;

        box-shadow: 0 10px 25px rgba(0,0,0,0.2);

    }


    .hero-btn-outline {

        border: 2px solid white;

        color: white;

        background: transparent;

    }


    .hero-btn-outline:hover {

        background: white;

        color: #0066ff;

        transform: translateY(-3px);

    }


    /* =====================================================
       COMMON SECTION
    ===================================================== */

    .quick-section,
    .how-section {

        padding: 90px 0;

        background: #ffffff;

    }


    .section-heading {

        text-align: center;

        max-width: 750px;

        margin: 0 auto 55px;

    }


    .section-heading span {

        color: #0066ff;

        font-size: 13px;

        font-weight: 800;

        letter-spacing: 2px;

    }


    .section-heading h2 {

        font-size: 38px;

        font-weight: 800;

        margin: 12px 0;

        color: #172033;

    }


    .section-heading p {

        color: #687386;

        font-size: 17px;

        line-height: 1.7;

    }


    /* =====================================================
       QUICK CARDS
    ===================================================== */

    .quick-grid {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 28px;

    }


    .quick-card {

        background: #ffffff;

        border-radius: 16px;

        overflow: hidden;

        box-shadow:
            0 10px 35px rgba(30,50,90,0.10);

        transition: all 0.3s ease;

    }


    .quick-card:hover {

        transform: translateY(-8px);

        box-shadow:
            0 18px 45px rgba(30,50,90,0.17);

    }


    .quick-image {

        height: 230px;

        background-size: cover;

        background-position: center;

        position: relative;

    }


    .facility-image {

        background-image:
            url("https://images.unsplash.com/photo-1553778263-73a83bab9b0c?auto=format&fit=crop&w=1000&q=80");

    }


    .equipment-image {

        background-image:
            url("https://images.unsplash.com/photo-1517466787929-bc90951d0974?auto=format&fit=crop&w=1000&q=80");

    }


    .booking-image {

        background-image:
            url("https://images.unsplash.com/photo-1518609878373-06d740f60d8b?auto=format&fit=crop&w=1000&q=80");

    }


    .image-overlay {

        position: absolute;

        inset: 0;

        display: flex;

        align-items: center;

        justify-content: center;

        background:
            linear-gradient(
                rgba(0,0,0,0.15),
                rgba(0,50,120,0.65)
            );

    }


    .big-icon {

        font-size: 65px;

        filter: drop-shadow(
            0 5px 10px rgba(0,0,0,0.3)
        );

    }


    .quick-content {

        padding: 28px;

    }


    .quick-content h3 {

        font-size: 23px;

        font-weight: 800;

        color: #172033;

    }


    .quick-content p {

        color: #687386;

        line-height: 1.7;

        min-height: 75px;

    }


    .quick-content a {

        color: #0066ff;

        font-weight: bold;

        text-decoration: none;

    }


    .quick-content a:hover {

        color: #0044aa;

    }


    /* =====================================================
       SPORTS
    ===================================================== */

    .sports-section {

        padding: 90px 0;

        background:
            linear-gradient(
                135deg,
                #071a35,
                #063f80
            );

    }


    .light-heading span {

        color: #65b5ff;

    }


    .light-heading h2 {

        color: white;

    }


    .light-heading p {

        color: rgba(255,255,255,0.70);

    }


    .sports-grid {

        display: grid;

        grid-template-columns:
            repeat(4, 1fr);

        gap: 20px;

    }


    .sport-card {

        height: 350px;

        position: relative;

        border-radius: 15px;

        overflow: hidden;

        background-size: cover;

        background-position: center;

        text-decoration: none !important;

        transition: transform 0.3s ease;

    }


    .sport-card:hover {

        transform: scale(1.025);

    }


    .football-card {

        background-image:
            url("https://images.unsplash.com/photo-1579952363873-27f3bade9f55?auto=format&fit=crop&w=1000&q=80");

    }


    .basketball-card {

        background-image:
            url("https://images.unsplash.com/photo-1546519638-68e109498ffc?auto=format&fit=crop&w=1000&q=80");

    }


    .tennis-card {

        background-image:
            url("https://images.unsplash.com/photo-1595435934249-5df7ed86e1c0?auto=format&fit=crop&w=1000&q=80");

    }


    .swimming-card {

        background-image:
            url("https://images.unsplash.com/photo-1530549387789-4c1017266635?auto=format&fit=crop&w=1000&q=80");

    }


    .sport-overlay {

        position: absolute;

        inset: 0;

        display: flex;

        align-items: flex-end;

        padding: 25px;

        background:
            linear-gradient(
                transparent 25%,
                rgba(0,0,0,0.85)
            );

        color: white;

    }


    .sport-overlay span {

        font-size: 40px;

    }


    .sport-overlay h3 {

        font-size: 26px;

        margin: 5px 0;

        font-weight: 800;

    }


    .sport-overlay p {

        margin: 0;

        color: rgba(255,255,255,0.80);

    }


    /* =====================================================
       HOW IT WORKS
    ===================================================== */

    .steps-grid {

        display: grid;

        grid-template-columns:
            repeat(3, 1fr);

        gap: 30px;

    }


    .step-card {

        position: relative;

        text-align: center;

        padding: 35px;

        background: #f7f9fc;

        border-radius: 15px;

    }


    .step-number {

        font-size: 13px;

        color: #0066ff;

        font-weight: 800;

        letter-spacing: 2px;

    }


    .step-icon {

        font-size: 50px;

        margin: 15px 0;

    }


    .step-card h3 {

        font-size: 25px;

        font-weight: 800;

    }


    .step-card p {

        color: #687386;

        line-height: 1.6;

    }


    /* =====================================================
       INQUIRY
    ===================================================== */

    .inquiry-section {

        position: relative;

        padding: 70px 0;

        color: white;

        background-image:
            url("https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1800&q=80");

        background-size: cover;

        background-position: center;

    }


    .inquiry-overlay {

        position: absolute;

        inset: 0;

        background:
            rgba(0,55,120,0.88);

    }


    .inquiry-content {

        position: relative;

        z-index: 2;

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 30px;

    }


    .inquiry-content span {

        font-size: 13px;

        font-weight: bold;

        letter-spacing: 2px;

        color: #8ecbff;

    }


    .inquiry-content h2 {

        font-size: 35px;

        font-weight: 800;

        margin: 10px 0;

    }


    .inquiry-content p {

        margin: 0;

        font-size: 17px;

        color: rgba(255,255,255,0.80);

    }


    .inquiry-btn {

        display: inline-block;

        padding: 15px 28px;

        background: white;

        color: #0066ff;

        border-radius: 8px;

        font-weight: bold;

        text-decoration: none !important;

        white-space: nowrap;

    }


    .inquiry-btn:hover {

        color: #0044aa;

        transform: translateY(-2px);

    }


    /* =====================================================
       MEMBER
    ===================================================== */

    .member-section {

        padding: 70px 0;

        background: #f7f9fc;

    }


    .member-box {

        display: flex;

        justify-content: space-between;

        align-items: center;

        gap: 30px;

        padding: 50px;

        border-radius: 20px;

        background:
            linear-gradient(
                135deg,
                #0066ff,
                #003d99
            );

        color: white;

        box-shadow:
            0 15px 40px rgba(0,60,150,0.20);

    }


    .member-box span {

        color: #9bd2ff;

        font-size: 13px;

        font-weight: bold;

        letter-spacing: 2px;

    }


    .member-box h2 {

        font-size: 32px;

        font-weight: 800;

        margin: 10px 0;

    }


    .member-box p {

        margin: 0;

        color: rgba(255,255,255,0.80);

    }


    .member-buttons {

        display: flex;

        gap: 10px;

        flex-shrink: 0;

    }


    .member-btn,
    .member-login-btn {

        padding: 14px 22px;

        border-radius: 8px;

        font-weight: bold;

        text-decoration: none !important;

    }


    .member-btn {

        background: white;

        color: #0066ff;

    }


    .member-login-btn {

        border: 2px solid white;

        color: white;

    }


    /* =========================================================
   RESPONSIVE DESIGN
   ========================================================= */

    @@media (max-width: 991px) {

        .hero-content h1 {
            font-size: 48px;
        }

        .quick-grid {
            grid-template-columns: 1fr;
        }

        .sports-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .inquiry-content {
            flex-direction: column;
            text-align: center;
        }

        .member-box {
            flex-direction: column;
        }
    }

    @@media (max-width: 991px) {

        .hero-content h1 {
            font-size: 48px;
        }

        .quick-grid {
            grid-template-columns: 1fr;
        }

        .sports-grid {
            grid-template-columns: repeat(2, 1fr);
        }

        .inquiry-content {
            flex-direction: column;
            text-align: center;
        }

        .member-box {
            flex-direction: column;
            text-align: center;
        }

    }


    @@media (max-width: 600px) {

        .sporthub-hero {
            min-height: 600px;
        }

        .hero-content h1 {
            font-size: 38px;
        }

        .hero-welcome {
            font-size: 20px;
        }

        .hero-description {
            font-size: 16px;
        }

        .section-heading h2 {
            font-size: 30px;
        }

        .sports-grid {
            grid-template-columns: 1fr;
        }

        .steps-grid {
            grid-template-columns: 1fr;
        }

        .member-box {
            padding: 30px 20px;
        }

        .member-box h2 {
            font-size: 26px;
        }

        .member-buttons {
            flex-direction: column;
            width: 100%;
        }

        .member-btn,
        .member-login-btn {
            text-align: center;
        }

    }

</style>