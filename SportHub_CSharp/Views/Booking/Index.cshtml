@model IEnumerable<SportHub_CSharp.Models.BOOKING>

@{
    ViewBag.Title = "Bookings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container" style="margin-top:30px; margin-bottom:50px;">

    <!-- HEADER -->
    <div style="
        background:#0d6efd;
        color:white;
        padding:20px;
        border-radius:6px;
        margin-bottom:25px;">

        <h2 style="margin:0;">
            📅 Sports Facility Bookings
        </h2>

        <p style="margin:8px 0 0 0;">
            Book your favourite sports facility quickly and easily.
        </p>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }


    <!-- MAIN OPTIONS -->
    <div class="row">

        <!-- FACILITIES -->
        <div class="col-md-4">

            <div class="panel panel-primary">

                <div class="panel-heading">
                    <h4>🏟️ Choose a Facility</h4>
                </div>

                <div class="panel-body text-center">

                    <div style="font-size:45px;">
                        🏟️
                    </div>

                    <p>
                        Select an available sports facility.
                    </p>

                    <a href="@Url.Action("Index", "Facility")"
                       class="btn btn-primary">

                        View Facilities

                    </a>

                </div>

            </div>

        </div>


        <!-- BOOK FACILITY -->
        <div class="col-md-4">

            <div class="panel panel-success">

                <div class="panel-heading">
                    <h4>📅 Make a Booking</h4>
                </div>

                <div class="panel-body text-center">

                    <div style="font-size:45px;">
                        📅
                    </div>

                    <p>
                        Select your preferred facility, date and time.
                    </p>

                    <a href="@Url.Action("Index", "Facility")"
                       class="btn btn-success">

                        Book a Facility

                    </a>

                </div>

            </div>

        </div>


        <!-- MY BOOKINGS -->
        <div class="col-md-4">

            <div class="panel panel-info">

                <div class="panel-heading">
                    <h4>📋 My Bookings</h4>
                </div>

                <div class="panel-body text-center">

                    <div style="font-size:45px;">
                        📋
                    </div>

                    <p>
                        View and manage your bookings.
                    </p>

                    <a href="@Url.Action("MyBookings", "Booking")"
                       class="btn btn-info">

                        My Bookings

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- HOW TO BOOK -->
    <div class="panel panel-default">

        <div class="panel-heading">

            <h4>
                How to Make a Booking
            </h4>

        </div>

        <div class="panel-body">

            <div class="row text-center">

                <div class="col-md-3">

                    <h3>1️⃣</h3>

                    <strong>Login</strong>

                    <p>
                        Sign in to your SportHub account.
                    </p>

                </div>


                <div class="col-md-3">

                    <h3>2️⃣</h3>

                    <strong>Choose Facility</strong>

                    <p>
                        Select an available facility.
                    </p>

                </div>


                <div class="col-md-3">

                    <h3>3️⃣</h3>

                    <strong>Select Date & Time</strong>

                    <p>
                        Select your preferred date and time.
                    </p>

                </div>


                <div class="col-md-3">

                    <h3>4️⃣</h3>

                    <strong>Confirm</strong>

                    <p>
                        Confirm your booking.
                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- BACK -->
    <div style="margin-top:20px;">

        <a href="@Url.Action("Index", "Home")"
           class="btn btn-secondary">

            🏠 Back to Home

        </a>

    </div>

</div>